# ──────────────────────────────────────────────────────────────────────────────
# Exemplo de Segredos e Propriedades da Aplicação (infra/ansible/secrets.yml)
# Copie este arquivo para "secrets.yml" e preencha com seus valores reais.
# Este arquivo NÃO é enviado para o Git (está no .gitignore).
# ──────────────────────────────────────────────────────────────────────────────

# ── Segredos do Backend Spring Boot ──────────────────────────────────────────
# Chave JWT (pelo menos 256 bits / 32 caracteres)
jwt_secret: "sua_chave_jwt_secreta_super_segura_aqui"

# Integração Azure AD / Microsoft OAuth2 (Opcional se não usar login Microsoft)
client_id: "seu_client_id_azure"
client_secret: "seu_client_secret_azure"
tenant_id: "common"
redirect_uri: "http://localhost:8080/login/oauth2/code/azure"

# ── Imagens Docker (Docker Hub) ──────────────────────────────────────────────
# Altere se desejar usar tags ou repositórios específicos
docker_backend_image: "lpamorim/sgpj-backend:latest"
docker_frontend_image: "lpamorim/sgpj-frontend:latest"
