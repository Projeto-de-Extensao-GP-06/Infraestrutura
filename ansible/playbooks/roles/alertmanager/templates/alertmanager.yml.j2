global:
  resolve_timeout: 5m
  smtp_smarthost: '{{ alertmanager_smtp_smarthost }}'
  smtp_from: '{{ alertmanager_smtp_from }}'
  smtp_auth_username: '{{ alertmanager_smtp_user }}'
  smtp_auth_password: '{{ alertmanager_smtp_password }}'
  smtp_require_tls: true

route:
  group_by: ['alertname', 'layer', 'severity']
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 10m
  receiver: 'email'

receivers:
  - name: 'email'
    email_configs:
      - to: '{{ alertmanager_alert_email }}'
        send_resolved: true
