upstream backend_cluster {
{% for host in backend_hosts | default([]) %}
    server {{ host }}:8080 max_fails=3 fail_timeout=10s;
{% endfor %}
{% if backend_hosts is not defined or backend_hosts | length == 0 %}
    server 127.0.0.1:8080 backup;
{% endif %}
    keepalive 32;
}

upstream agent_cluster {
{% for host in backend_hosts | default([]) %}
    server {{ host }}:8000 max_fails=3 fail_timeout=10s;
{% endfor %}
{% if backend_hosts is not defined or backend_hosts | length == 0 %}
    server 127.0.0.1:8000 backup;
{% endif %}
    keepalive 8;
}

server {
    listen 80;
    server_name _;

    client_max_body_size 260M;

    # Sem cache no index.html para que novas versoes carreguem assets corretos
    location = /index.html {
        root /usr/share/nginx/html;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
        add_header Expires "0";
    }

    # Assets estaticos gerados pelo Vite (CSS, JS, fontes, imagens) com cache longo
    location /assets/ {
        root /usr/share/nginx/html;
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # MarIA AI Agent - FastAPI Python
    # Frontend chama /agent/api/v1/... -> Nginx remove o prefixo /agent e repassa na porta 8000
    location /agent/ {
        proxy_pass http://agent_cluster/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_connect_timeout 15s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
    }

    # Frontend React (Single Page Application)
    location / {
        root /usr/share/nginx/html;
        index index.html index.htm;
        try_files $uri $uri/ /index.html;
    }

    # Server-Sent Events (SSE) para sincronizacao de processos em tempo real
    location ~ ^/processos/[^/]+/sincronizacao-status {
        proxy_pass http://backend_cluster;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection '';

        # Buffering desabilitado para SSE fluir em tempo real
        proxy_buffering off;
        proxy_cache off;
        chunked_transfer_encoding off;

        proxy_connect_timeout 15s;
        proxy_send_timeout 600s;
        proxy_read_timeout 600s;
    }

    # Roteamento de endpoints da API para o cluster de backend
    location ~ ^/(auth|usuarios|processos?|audiencias|clientes|dashboard|documentos|notificacoes|cargos|permissoes|relatorios|prioridades|solicitacoes|siglaTribunais|statusClientes|tiposAlteracao|tiposDocumento|fasesProcesso|motivosStatusProcesso|api-onedrive|login|historico|api|actuator) {
        proxy_pass http://backend_cluster;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";

        proxy_next_upstream error timeout http_502 http_503 http_504;
        proxy_connect_timeout 15s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
    }
}
