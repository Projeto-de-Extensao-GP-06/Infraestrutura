apiVersion: 1

datasources:
  - name: Prometheus
    uid: prometheus
    type: prometheus
    access: proxy
    url: {{ grafana_prometheus_url }}
    isDefault: true
    editable: true

  - name: Loki
    uid: loki
    type: loki
    access: proxy
    url: {{ grafana_loki_url }}
    editable: true

  - name: Athena
    uid: athena
    type: grafana-athena-datasource
    access: proxy
    isDefault: false
    editable: true
    jsonData:
      authType: default
      defaultRegion: {{ aws_region | default('us-east-1') }}
      catalog: AwsDataCatalog
      database: sgpj_logs_bronze
      workgroup: primary
      outputLocation: "s3://{{ bronze_bucket | default('sgpj-bronze') }}/athena-results/"
