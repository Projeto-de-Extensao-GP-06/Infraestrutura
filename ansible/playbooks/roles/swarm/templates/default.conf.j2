upstream backend_cluster {
{% for host in groups['backend'] %}
    server {{ hostvars[host]['ansible_host'] | default(hostvars[host]['ansible_default_ipv4']['address']) }}:8080 max_fails=3 fail_timeout=10s;
{% endfor %}
}

server {
    listen 80;
    server_name localhost;

    client_max_body_size 260M;

    # Evita cache do index.html para que novas versões carreguem os assets corretos de primeira
    location = /index.html {
        root /usr/share/nginx/html;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
        add_header Expires "0";
    }

    # Arquivos estáticos gerados pelo Vite (CSS, JS, fontes, imagens)
    # Se não existirem, devem retornar 404 em vez de cair no index.html (evita MIME type mismatch)
    location /assets/ {
        root /usr/share/nginx/html;
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location / {
        root /usr/share/nginx/html;
        index index.html index.htm;
        try_files $uri $uri/ /index.html;
    }

    # Server-Sent Events (SSE) para sincronização de processos em tempo real
    location ~ ^/processos/[^/]+/sincronizacao-status {
        proxy_pass http://backend_cluster;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection '';

        # Desabilita buffering e cache para SSE fluir em tempo real sem travar chunks
        proxy_buffering off;
        proxy_cache off;
        chunked_transfer_encoding off;

        proxy_connect_timeout 15s;
        proxy_send_timeout 600s;
        proxy_read_timeout 600s;
    }

    location ~ ^/(auth|usuarios|processos?|audiencias|clientes|dashboard|documentos|notificacoes|cargos|permissoes|relatorios|prioridades|solicitacoes|siglaTribunais|statusClientes|tiposAlteracao|tiposDocumento|fasesProcesso|motivosStatusProcesso|api-onedrive|login|historico|api|actuator) {
        proxy_pass http://backend_cluster;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_next_upstream error timeout http_502 http_503 http_504;
        proxy_connect_timeout 15s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
    }
}
