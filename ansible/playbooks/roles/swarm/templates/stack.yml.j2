version: "3.9"

# ──────────────────────────────────────────────────────────────────────────────
# Docker Swarm Stack — SGPJ
# Gerado pelo Ansible (roles/swarm/templates/stack.yml.j2)
# NÃO EDITE MANUALMENTE.
#
# Arquitetura de rede:
#   [ALB :80] → [nginx service :80] → proxy /api/ → [backend service :8080]
#                                   → serve static → /usr/share/nginx/html/
#
# O nginx.conf do Frontend usa "api.backend" como hostname do backend.
# O alias de rede abaixo faz o Swarm resolver "api.backend" → serviço backend.
# ──────────────────────────────────────────────────────────────────────────────

networks:
  sgpj_net:
    driver: overlay
    attachable: true

services:

  # ── Nginx / Frontend React ─────────────────────────────────────────────────
  # Imagem construída com:
  #   nginx.conf  → proxy /api/ para api.backend:8080
  #   dist/       → arquivos estáticos do npm run build
  nginx:
    image: {{ ecr_frontend_image }}
    networks:
      - sgpj_net
    ports:
      - "80:80"        # ALB aponta para porta 80 das EC2 app
    deploy:
      replicas: 2
      placement:
        constraints:
          - node.labels.role == app
      update_config:
        parallelism: 1          # atualiza 1 réplica por vez
        delay: 10s
        failure_action: rollback
        order: start-first      # sobe novo antes de parar o antigo (zero-downtime)
      rollback_config:
        parallelism: 1
        delay: 5s
      restart_policy:
        condition: on-failure
        delay: 5s
        max_attempts: 3
    healthcheck:
      test: ["CMD", "wget", "-qO-", "http://127.0.0.1:80"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 15s

  # ── Backend Spring Boot ────────────────────────────────────────────────────
  # Imagem construída com:
  #   mvn package → target/*.jar copiado como app.jar
  backend:
    image: {{ ecr_backend_image }}
    networks:
      sgpj_net:
        aliases:
          - api.backend    # permite que o nginx resolva "api.backend" via DNS do Swarm
    ports:
      - "8080:8080"
    environment:
      DB_HOST: "{{ db_host }}"
      DB_NAME: "{{ mysql_database }}"
      DB_USERNAME: "{{ mysql_user }}"
      DB_PASSWORD: "{{ mysql_password }}"
      SPRING_DATASOURCE_URL: "jdbc:mysql://{{ db_host }}:3306/{{ mysql_database }}?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8&useUnicode=true"
      SPRING_DATASOURCE_USERNAME: "{{ mysql_user }}"
      SPRING_DATASOURCE_PASSWORD: "{{ mysql_password }}"
      SPRING_DATASOURCE_DRIVER_CLASS_NAME: "com.mysql.cj.jdbc.Driver"
      SPRING_JPA_DATABASE_PLATFORM: "org.hibernate.dialect.MySQLDialect"
      SERVER_PORT: "8080"
{% set _jwt = backend_jwt_secret | default(jwt_secret, true) %}
{% if _jwt %}
      JWT_SECRET: "{{ _jwt }}"
{% endif %}
{% set _client_id = backend_client_id | default(client_id, true) %}
{% if _client_id %}
      CLIENT_ID: "{{ _client_id }}"
{% endif %}
{% set _client_secret = backend_client_secret | default(client_secret, true) %}
{% if _client_secret %}
      CLIENT_SECRET: "{{ _client_secret }}"
{% endif %}
{% set _tenant_id = backend_tenant_id | default(tenant_id, true) %}
{% if _tenant_id %}
      TENANT_ID: "{{ _tenant_id }}"
{% endif %}
{% set _redirect_uri = backend_redirect_uri | default(redirect_uri, true) %}
{% if _redirect_uri %}
      REDIRECT_URI: "{{ _redirect_uri }}"
{% endif %}
{% set _cookie_secure = backend_cookie_secure | default(cookie_secure, true) %}
{% if _cookie_secure is defined and _cookie_secure != '' %}
      COOKIE_SECURE: "{{ _cookie_secure }}"
{% endif %}
{% set _datajud = backend_datajud_api_key | default(datajud_api_key, true) %}
{% if _datajud %}
      DATAJUD_API_KEY: "{{ _datajud }}"
{% endif %}
{% set _cf_key = backend_cloudflare_secret_key | default(cloudflare_secret_key, true) %}
{% if _cf_key %}
      CLOUDFLARE_SECRET_KEY: "{{ _cf_key }}"
{% endif %}
{% if enable_observability | default(false) | bool and observability_host is defined %}
      # OpenTelemetry: envia traces para o Alloy local da EC2 (porta 4318 HTTP)
      # O Alloy recebe e repassa para o Tempo na ec2-observability via gRPC 4317
      OTEL_EXPORTER_OTLP_ENDPOINT: "http://{{ observability_host }}:4318"
      OTEL_SERVICE_NAME: "sgpj-backend"
      OTEL_TRACES_EXPORTER: "otlp"
{% endif %}
    deploy:
      replicas: 2
      placement:
        constraints:
          - node.labels.role == backend
      update_config:
        parallelism: 1          # atualiza 1 réplica por vez
        delay: 15s
        failure_action: rollback
        order: start-first      # zero-downtime
      rollback_config:
        parallelism: 1
        delay: 5s
      restart_policy:
        condition: any
        delay: 10s
        max_attempts: 5
    healthcheck:
      test: ["CMD", "wget", "-qO-", "http://localhost:8080/actuator/health"]
      interval: 30s
      timeout: 15s
      retries: 5
      start_period: 60s
