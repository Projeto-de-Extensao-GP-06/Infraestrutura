version: "3.9"

# ──────────────────────────────────────────────────────────────────────────────
# Docker Swarm Stack — SGPJ
# Gerado pelo Ansible (roles/swarm/templates/stack.yml.j2)
# ──────────────────────────────────────────────────────────────────────────────

networks:
  sgpj_net:
    driver: overlay
    attachable: true

services:

  # ── Nginx / Frontend React ─────────────────────────────────────────────────
  nginx:
    image: {{ ecr_frontend_image }}
    networks:
      - sgpj_net
    ports:
      - "80:80"
    volumes:
      - /opt/nginx/default.conf:/etc/nginx/conf.d/default.conf:ro
    deploy:
      replicas: 2
      placement:
        constraints:
          - node.labels.role == app
      update_config:
        parallelism: 1
        delay: 10s
        failure_action: rollback
        order: start-first
      rollback_config:
        parallelism: 1
        delay: 5s
      restart_policy:
        condition: on-failure
        delay: 5s
        max_attempts: 3
    healthcheck:
      test: ["CMD", "wget", "-qO-", "http://127.0.0.1:80"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 15s

  # ── Backend Spring Boot ────────────────────────────────────────────────────
  backend:
    image: {{ ecr_backend_image }}
    networks:
      sgpj_net:
        aliases:
          - api.backend
    ports:
      - "8080:8080"
    environment:
      DB_HOST: "{{ db_host }}"
      DB_NAME: "{{ mysql_database }}"
      DB_USERNAME: "{{ mysql_user }}"
      DB_PASSWORD: "{{ mysql_password }}"
      SPRING_DATASOURCE_URL: "jdbc:mysql://{{ db_host }}:3306/{{ mysql_database }}?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8&useUnicode=true"
      SPRING_DATASOURCE_USERNAME: "{{ mysql_user }}"
      SPRING_DATASOURCE_PASSWORD: "{{ mysql_password }}"
      SPRING_DATASOURCE_DRIVER_CLASS_NAME: "com.mysql.cj.jdbc.Driver"
      SPRING_JPA_DATABASE_PLATFORM: "org.hibernate.dialect.MySQLDialect"
      SERVER_PORT: "8080"
      MANAGEMENT_HEALTH_MAIL_ENABLED: "false"
{% set _jwt = backend_jwt_secret | default(jwt_secret, true) %}
{% if _jwt %}
      JWT_SECRET: "{{ _jwt }}"
{% endif %}
{% set _client_id = backend_client_id | default(client_id, true) %}
{% if _client_id %}
      CLIENT_ID: "{{ _client_id }}"
{% endif %}
{% set _client_secret = backend_client_secret | default(client_secret, true) %}
{% if _client_secret %}
      CLIENT_SECRET: "{{ _client_secret }}"
{% endif %}
{% set _tenant_id = backend_tenant_id | default(tenant_id, true) %}
{% if _tenant_id %}
      TENANT_ID: "{{ _tenant_id }}"
{% endif %}
{% set _redirect_uri = backend_redirect_uri | default(redirect_uri, true) %}
{% if _redirect_uri %}
      REDIRECT_URI: "{{ _redirect_uri }}"
{% endif %}
{% set _cookie_secure = backend_cookie_secure | default(cookie_secure, true) %}
{% if _cookie_secure is defined and _cookie_secure != '' %}
      COOKIE_SECURE: "{{ _cookie_secure }}"
{% endif %}
{% set _datajud = backend_datajud_api_key | default(datajud_api_key, true) %}
{% if _datajud %}
      DATAJUD_API_KEY: "{{ _datajud }}"
{% endif %}
{% set _cf_key = backend_cloudflare_secret_key | default(cloudflare_secret_key, true) %}
{% if _cf_key %}
      CLOUDFLARE_SECRET_KEY: "{{ _cf_key }}"
{% endif %}
    deploy:
      replicas: 2
      placement:
        constraints:
          - node.labels.role == backend
      update_config:
        parallelism: 1
        delay: 15s
        failure_action: rollback
        order: start-first
      rollback_config:
        parallelism: 1
        delay: 5s
      restart_policy:
        condition: any
        delay: 10s
        max_attempts: 5
