[app]
ec2-app-a ansible_host=${app_a_public_ip}
ec2-app-b ansible_host=${app_b_public_ip}

%{ if enable_observability ~}
[observability]
ec2-observability ansible_host=${observability_public_ip}
%{ endif ~}

[backend]
ec2-backend-a ansible_host=${backend_a_private_ip}
ec2-backend-b ansible_host=${backend_b_private_ip}

[db]
ec2-db ansible_host=${db_private_ip}

[private:children]
backend
db

[all:vars]
ansible_user=ubuntu
ansible_ssh_private_key_file=~/.ssh/vokey.pem
ansible_ssh_common_args='-o StrictHostKeyChecking=no -o ConnectTimeout=15'
efs_dns=${efs_dns_name}

[private:vars]
ansible_ssh_common_args='-o StrictHostKeyChecking=no -o ConnectTimeout=15 -o ProxyCommand="ssh -i ~/.ssh/vokey.pem -o StrictHostKeyChecking=no -W %h:%p ubuntu@${app_a_public_ip}"'
