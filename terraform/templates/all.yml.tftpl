---
# ---------------------------------------------------------------------------
# Arquivo gerado automaticamente pelo Terraform (templates/all.yml.tftpl)
# NAO EDITE MANUALMENTE. Suas alteracoes serao sobrescritas no terraform apply.
# ---------------------------------------------------------------------------

aws_region: "${aws_region}"
efs_dns: "${efs_dns}"

# -- Conectividade entre Camadas (Service Discovery Automatico) -------------
db_host: "${db_host}"
db_port: 3306
mysql_database: "${mysql_database}"
mysql_user: "${mysql_user}"
mysql_password: "${mysql_password}"
mysql_root_password: "${mysql_password}"

backend_hosts:
  - "${backend_a_ip}"
  - "${backend_b_ip}"

# -- Repositorios de Imagens Docker (Amazon ECR) ----------------------------
use_ecr: true
ecr_registry_url: "${split("/", ecr_frontend_url)[0]}"
ecr_frontend_image: "${ecr_frontend_url}:latest"
ecr_backend_image: "${ecr_backend_url}:latest"
ecr_agent_image: "${ecr_agent_url}:latest"

# -- Data Lake / Logs S3 (Fluent Bit) ---------------------------------------
bronze_bucket: "${bronze_bucket}"
s3_bronze_bucket: "${bronze_bucket}"

# -- Configuracao de Observabilidade (Opcional) -----------------------------
enable_observability: ${enable_observability}
observability_host: "${observability_ip}"
