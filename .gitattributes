# Auto detect text files and perform LF normalization
* text=auto

# Explicitly declare text files you want to always be normalized and converted to native line endings on checkout
*.tf text
*.tfvars text
*.yml text
*.yaml text
*.json text
*.md text
*.py text
*.sql text
*.csv text

# Scripts Linux/Bash e arquivos executaveis DEVEM sempre ter final de linha LF (nunca CRLF)
*.sh text eol=lf
*.bash text eol=lf
*.zsh text eol=lf
ansible.cfg text eol=lf
hosts text eol=lf
production.ini text eol=lf
*.service text eol=lf
*.conf text eol=lf
